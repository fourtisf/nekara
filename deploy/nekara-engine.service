# /etc/systemd/system/nekara-engine.service
#
# One process: discovery, the hot and warm scorers, the daily anchor, the
# register API on :8787 and the websocket feed. index.js starts all of it.

[Unit]
Description=Nekara signal engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nekara/signal-engine
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5

# The register lives here as an append-only file. Losing it loses the record,
# and the hash chain is what makes that irrecoverable rather than annoying.
ReadWritePaths=/opt/nekara/signal-engine/data

# Sessions are signed with this. Leave it unset and index.js generates a random
# one at boot, which silently logs every key holder out on each restart.
Environment=SESSION_SECRET=CHANGE_ME
Environment=AUTH_DOMAIN=nekara.xyz
Environment=CALLER_ID=1

# Telegram is optional. Without it the engine still records everything; it just
# does not announce — and losses get posted too, which is the point. Set these
# in a drop-in rather than here, for the same reason as PUBLIC_DELAY_S below:
# golive.sh reinstalls this file on every run.
#
#   mkdir -p /etc/systemd/system/nekara-engine.service.d
#   printf '[Service]\nEnvironment=TG_TOKEN=...\nEnvironment=TG_CHAT=...\n' \
#     > /etc/systemd/system/nekara-engine.service.d/telegram.conf
#   systemctl daemon-reload && systemctl restart nekara-engine
#
# The engine logs "[telegram] not configured, skipping" until they are set.

# How far behind the desk a reader with no key sits. The paid tiers (0s, 5s,
# 10s) are the promise and are not settable; this one is a product decision.
# Leave it out for an hour. While no keys exist, an hour is a delay nobody has
# paid to skip, and the public page is empty for that hour after every signal.
#
# Do not set it by editing this file: golive.sh installs this file over yours
# on every run, so the edit disappears at the next deploy. Use a drop-in, which
# survives and wins over anything here:
#
#   mkdir -p /etc/systemd/system/nekara-engine.service.d
#   printf '[Service]\nEnvironment=PUBLIC_DELAY_S=60\n' \
#     > /etc/systemd/system/nekara-engine.service.d/public-delay.conf
#   systemctl daemon-reload && systemctl restart nekara-engine
#
# The engine logs the ladder it actually loaded at boot — check it there rather
# than trusting the edit:
#   journalctl -u nekara-engine -n 20 --no-pager | grep "tier latency"

# Tier gating resolves on-chain when both are set. Without them everyone is
# public tier, which is correct while no keys exist.
# Where the watchdog says the engine is down. Never TG_CHAT: the channel carries
# a call and how far it ran, and an ops alarm there only teaches subscribers to
# distrust the desk. A DM to yourself is the right room; unset means the journal
# only, and the watchdog says so rather than falling back to the channel.
# Environment=TG_OPS_CHAT=

# Environment=KEYS_CONTRACT=
# Environment=BASE_RPC=

# Storage. Unset means the file register. Set it and the engine runs on
# Postgres, where the append-only rule is enforced by the database rather than
# by this process. Migrate an existing file register across first with
# migrate-pg.js — it refuses rather than half-migrating, because `calls` cannot
# delete the rows a partial run would leave behind.
# Environment=DATABASE_URL=postgres://nekara@127.0.0.1/nekara

# On-chain gates: mint and freeze authority, holder concentration, LP burn.
# Unset means they never run, the engine fires exactly as before, and every
# call records chainChecks: null — published as "not checked", never as clean.
# Set through a drop-in, for the reason above.
#   printf '[Service]\nEnvironment=HELIUS_KEY=...\n' \
#     > /etc/systemd/system/nekara-engine.service.d/chain.conf
# Environment=HELIUS_KEY=
# Environment=SOLANA_RPC=

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
